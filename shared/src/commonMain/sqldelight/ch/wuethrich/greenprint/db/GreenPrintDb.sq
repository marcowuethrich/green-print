CREATE TABLE SpaceEntity (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    icon TEXT,
    syncStatus TEXT NOT NULL DEFAULT 'S_SYNCED',
    updatedAt INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE RoomEntity (
    id TEXT NOT NULL PRIMARY KEY,
    spaceId TEXT NOT NULL,
    name TEXT NOT NULL,
    icon TEXT,
    syncStatus TEXT NOT NULL DEFAULT 'S_SYNCED',
    updatedAt INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY(spaceId) REFERENCES SpaceEntity(id) ON DELETE CASCADE
);

CREATE TABLE PlantEntity (
    id TEXT NOT NULL PRIMARY KEY,
    roomId TEXT NOT NULL,
    name TEXT NOT NULL,
    species TEXT,
    potSize TEXT,
    soilType TEXT,
    wateringIntervalDays INTEGER NOT NULL,
    lastWateredDate TEXT,
    photoUrl TEXT,
    archiveDate TEXT,
    archiveReason TEXT,
    x REAL NOT NULL DEFAULT 0.0,
    y REAL NOT NULL DEFAULT 0.0,
    syncStatus TEXT NOT NULL DEFAULT 'S_SYNCED',
    updatedAt INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY(roomId) REFERENCES RoomEntity(id) ON DELETE CASCADE
);

CREATE TABLE WateringEventEntity (
    id TEXT NOT NULL PRIMARY KEY,
    plantId TEXT NOT NULL,
    timestamp TEXT NOT NULL,
    syncStatus TEXT NOT NULL DEFAULT 'S_SYNCED',
    updatedAt INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY(plantId) REFERENCES PlantEntity(id) ON DELETE CASCADE
);

-- Space Queries
insertSpace:
INSERT OR REPLACE INTO SpaceEntity(id, name, icon, syncStatus, updatedAt) VALUES (?, ?, ?, ?, ?);

selectAllSpaces:
SELECT * FROM SpaceEntity;

selectSpaceById:
SELECT * FROM SpaceEntity WHERE id = ?;

deleteSpace:
DELETE FROM SpaceEntity WHERE id = ?;

deleteAllSpaces:
DELETE FROM SpaceEntity;

-- Room Queries
insertRoom:
INSERT OR REPLACE INTO RoomEntity(id, spaceId, name, icon, syncStatus, updatedAt) VALUES (?, ?, ?, ?, ?, ?);

selectAllRooms:
SELECT * FROM RoomEntity;

selectRoomsBySpaceId:
SELECT * FROM RoomEntity WHERE spaceId = ?;

deleteRoom:
DELETE FROM RoomEntity WHERE id = ?;

deleteAllRooms:
DELETE FROM RoomEntity;

-- Plant Queries
insertPlant:
INSERT OR REPLACE INTO PlantEntity(
    id, roomId, name, species, potSize, soilType, 
    wateringIntervalDays, lastWateredDate, photoUrl, archiveDate, archiveReason, x, y, syncStatus, updatedAt
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectAllPlants:
SELECT * FROM PlantEntity;

selectPlantsByRoomId:
SELECT * FROM PlantEntity WHERE roomId = ?;

selectPlantById:
SELECT * FROM PlantEntity WHERE id = ?;

deletePlant:
DELETE FROM PlantEntity WHERE id = ?;

deleteAllPlants:
DELETE FROM PlantEntity;

-- Blueprint moves are written through: the local row moves first, marked S_PENDING, then the
-- server confirms it. updatedAt stamps each move, so a server answer only settles the move it was
-- sent for, never a newer one made while it was on the way.
updatePlantPosition:
UPDATE PlantEntity SET x = :x, y = :y, syncStatus = :syncStatus, updatedAt = :updatedAt WHERE id = :id;

updatePlantSyncStatusIfUnchanged:
UPDATE PlantEntity SET syncStatus = :syncStatus WHERE id = :id AND updatedAt = :updatedAt;

selectUnsyncedPlantsByRoomId:
SELECT * FROM PlantEntity WHERE roomId = ? AND syncStatus != 'S_SYNCED';

-- A plant changed on this device keeps its local row on a refresh (last write wins): a move the
-- server has not confirmed, or a watering it has not received yet.
selectLocallyChangedPlantIdsByRoomId:
SELECT id FROM PlantEntity WHERE roomId = :roomId AND (
    syncStatus != 'S_SYNCED' OR id IN (SELECT plantId FROM WateringEventEntity WHERE syncStatus != 'S_SYNCED')
);

-- A refresh replaces the room's rows, except those it must keep: changed locally, or written while
-- the refresh was on the way.
deletePlantsByRoomIdExcept:
DELETE FROM PlantEntity WHERE roomId = :roomId AND id NOT IN :keep;

-- A watering is written through like a move: the plant's lastWateredDate moves at once, the
-- watering waits in WateringEventEntity until the server has it.
updatePlantLastWatered:
UPDATE PlantEntity SET lastWateredDate = :lastWateredDate WHERE id = :id;

-- Watering Event Queries
insertWateringEvent:
INSERT OR REPLACE INTO WateringEventEntity(id, plantId, timestamp, syncStatus, updatedAt) VALUES (?, ?, ?, ?, ?);

selectWateringEventsByPlantId:
SELECT * FROM WateringEventEntity WHERE plantId = ? ORDER BY timestamp DESC;

selectUnsyncedWateringEventsByPlantId:
SELECT * FROM WateringEventEntity WHERE plantId = ? AND syncStatus != 'S_SYNCED';

selectUnsyncedWateringEventsByRoomId:
SELECT WateringEventEntity.* FROM WateringEventEntity
JOIN PlantEntity ON PlantEntity.id = WateringEventEntity.plantId
WHERE PlantEntity.roomId = ? AND WateringEventEntity.syncStatus != 'S_SYNCED'
ORDER BY WateringEventEntity.timestamp;

selectWateringEventById:
SELECT * FROM WateringEventEntity WHERE id = ?;

updateWateringEventSyncStatus:
UPDATE WateringEventEntity SET syncStatus = :syncStatus WHERE id = :id;

deleteWateringEvent:
DELETE FROM WateringEventEntity WHERE id = ?;

deleteWateringEventsByPlantId:
DELETE FROM WateringEventEntity WHERE plantId = ?;

deleteAllWateringEvents:
DELETE FROM WateringEventEntity;
