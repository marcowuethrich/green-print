CREATE TABLE SpaceEntity (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    icon TEXT
);

CREATE TABLE RoomEntity (
    id TEXT NOT NULL PRIMARY KEY,
    spaceId TEXT NOT NULL,
    name TEXT NOT NULL,
    icon TEXT,
    FOREIGN KEY(spaceId) REFERENCES SpaceEntity(id) ON DELETE CASCADE
);

CREATE TABLE PlantEntity (
    id TEXT NOT NULL PRIMARY KEY,
    roomId TEXT NOT NULL,
    name TEXT NOT NULL,
    species TEXT,
    potSize TEXT,
    soilType TEXT,
    wateringIntervalDays INTEGER NOT NULL,
    lastWateredDate TEXT,
    archiveDate TEXT,
    archiveReason TEXT,
    x REAL NOT NULL DEFAULT 0.0,
    y REAL NOT NULL DEFAULT 0.0,
    FOREIGN KEY(roomId) REFERENCES RoomEntity(id) ON DELETE CASCADE
);

CREATE TABLE WateringEventEntity (
    id TEXT NOT NULL PRIMARY KEY,
    plantId TEXT NOT NULL,
    timestamp TEXT NOT NULL,
    FOREIGN KEY(plantId) REFERENCES PlantEntity(id) ON DELETE CASCADE
);

-- Space Queries
insertSpace:
INSERT OR REPLACE INTO SpaceEntity(id, name, icon) VALUES (?, ?, ?);

selectAllSpaces:
SELECT * FROM SpaceEntity;

selectSpaceById:
SELECT * FROM SpaceEntity WHERE id = ?;

deleteSpace:
DELETE FROM SpaceEntity WHERE id = ?;

deleteAllSpaces:
DELETE FROM SpaceEntity;

-- Room Queries
insertRoom:
INSERT OR REPLACE INTO RoomEntity(id, spaceId, name, icon) VALUES (?, ?, ?, ?);

selectAllRooms:
SELECT * FROM RoomEntity;

selectRoomsBySpaceId:
SELECT * FROM RoomEntity WHERE spaceId = ?;

deleteRoom:
DELETE FROM RoomEntity WHERE id = ?;

deleteAllRooms:
DELETE FROM RoomEntity;

-- Plant Queries
insertPlant:
INSERT OR REPLACE INTO PlantEntity(
    id, roomId, name, species, potSize, soilType, 
    wateringIntervalDays, lastWateredDate, archiveDate, archiveReason, x, y
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectAllPlants:
SELECT * FROM PlantEntity;

selectPlantsByRoomId:
SELECT * FROM PlantEntity WHERE roomId = ?;

selectPlantById:
SELECT * FROM PlantEntity WHERE id = ?;

deletePlant:
DELETE FROM PlantEntity WHERE id = ?;

deleteAllPlants:
DELETE FROM PlantEntity;

-- Watering Event Queries
insertWateringEvent:
INSERT OR REPLACE INTO WateringEventEntity(id, plantId, timestamp) VALUES (?, ?, ?);

selectWateringEventsByPlantId:
SELECT * FROM WateringEventEntity WHERE plantId = ? ORDER BY timestamp DESC;

deleteAllWateringEvents:
DELETE FROM WateringEventEntity;
